{
  "name": "happs-js-sdk",
  "version": "1.1.0",
  "description": "Framework-agnostic browser SDK for Hooli Games portal integrations",
  "scripts": {
    "build": "node scripts/build.cjs",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --lib ES2020,DOM index.d.ts core.d.ts unity.d.ts",
    "test": "npm run build && node --test test/*.test.cjs",
    "validate": "npm run typecheck && npm test"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "browser": "dist/index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./core": {
      "types": "./core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs"
    },
    "./unity": {
      "types": "./unity.d.ts",
      "import": "./dist/unity.mjs",
      "require": "./dist/unity.cjs"
    },
    "./versions/*": "./versions/*"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "core.d.ts",
    "unity.d.ts",
    "dist",
    "versions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hooligapps/happs-js-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/hooligapps/happs-js-sdk/issues"
  },
  "homepage": "https://github.com/hooligapps/happs-js-sdk#readme",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  }
}
